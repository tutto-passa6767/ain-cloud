{
  "name": "@ain/db",
  "version": "0.1.0",
  "private": true,
  "description": "Схема БД, миграции и Prisma Client для API и воркера",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- node prisma/seed.js",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "postinstall": "prisma generate",
    "staff": "dotenv -e ../../.env -- node prisma/make-staff.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "prisma": "6.19.3"
  }
}
