# AIN Cloud — пример настроек для локальной среды.
# Скопируйте в .env командой `npm run env:init` — она подставит случайные секреты.
# Реальные секреты в репозиторий не попадают (ТЗ §10.1, §19).

# --- PostgreSQL ---
POSTGRES_USER=ain
POSTGRES_PASSWORD=__RANDOM__
POSTGRES_DB=ain
POSTGRES_PORT=55432
DATABASE_URL=postgresql://ain:${POSTGRES_PASSWORD}@localhost:55432/ain

# --- Redis (очередь BullMQ) ---
REDIS_PORT=56379
REDIS_URL=redis://localhost:56379

# --- S3-совместимое хранилище (MinIO локально) ---
MINIO_ROOT_USER=ain-admin
MINIO_ROOT_PASSWORD=__RANDOM__
# Ключ шифрования данных в хранилище (SSE, AES-256): имя:base64(32 байта)
MINIO_KMS_SECRET_KEY=ain-sse-key:__RANDOM_B64_32__
MINIO_PORT=59000
MINIO_CONSOLE_PORT=59001
S3_ENDPOINT=http://localhost:59000
# Адрес хранилища, по которому к нему обращается браузер (подписанные ссылки)
S3_PUBLIC_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_ACCESS_KEY=ain-admin
S3_SECRET_KEY=${MINIO_ROOT_PASSWORD}
S3_BUCKET_ORIGINALS=ain-originals
S3_BUCKET_DERIVED=ain-derived

# --- Почта (локально — Mailpit, письма видны на http://localhost:58025) ---
SMTP_HOST=localhost
SMTP_PORT=51025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="AIN Cloud <no-reply@ain.kz>"
MAILPIT_UI_PORT=58025
MAILPIT_SMTP_PORT=51025

# --- Приложение ---
APP_URL=http://localhost:3000
API_PORT=4000
API_INTERNAL_URL=http://localhost:4000
COOKIE_SECURE=false
# Подпись cookie доступа к ссылкам с паролем
APP_SECRET=__RANDOM__
SESSION_TTL_DAYS=30

# --- Загрузка (ТЗ §6) ---
UPLOAD_PART_SIZE_MB=64
UPLOAD_PARALLEL_PARTS=4
UPLOAD_SESSION_TTL_DAYS=7
SIGNED_URL_TTL_SEC=900

# --- Обработка ---
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# Файлы больше этого размера антивирус проверить не может (технический предел ClamAV — 2 ГБ).
# Такие файлы получают состояние «Ограничен» (ТЗ §10.1).
AV_MAX_SCAN_MB=2000
TRASH_RETENTION_DAYS=30
